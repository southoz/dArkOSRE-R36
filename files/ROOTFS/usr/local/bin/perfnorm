#!/bin/bash

launch_root=/roms
case "${2:-}" in
  /roms2/*) if mountpoint -q /roms2; then launch_root=/roms2; fi ;;
  /roms/*) launch_root=/roms ;;
  *) if mountpoint -q /roms2 && grep -Eq '<path>/roms2/' /etc/emulationstation/es_systems.cfg; then
       launch_root=/roms2
     fi ;;
esac
printf "\033c" >> /dev/tty1
export SDL_VIDEO_EGL_DRIVER=libEGL.so
gpu="ff400000"

if [ -e "/home/ark/.config/.GameLoadingIModeASCII" ] && [[ $(tty) != *"pts"* ]]; then
  if [ -f "${launch_root}/launchimages/loading.ascii" ]; then
    echo -en "\033[21m" > /dev/tty1 && cat "${launch_root}/launchimages/loading.ascii" > /dev/tty1
  else
    : # No fallback artwork on this ROM card.
  fi
elif [ -e "/home/ark/.config/.GameLoadingIModeGIF" ] && [[ $(tty) != *"pts"* ]]; then
  #if [ -e "/home/ark/.config/.IMAGEDELAYTIME" ]; then
  #  delay="$(cat /home/ark/.config/.IMAGEDELAYTIME)"
  #else
    delay="1.5"
  #fi
  if [ -f "${launch_root}/launchimages/loading.gif" ]; then
    ffplay -x 1280 -y 720 -loglevel quiet -autoexit "${launch_root}/launchimages/loading.gif" &
    PROC=$!
    (sleep ${delay}s; kill -9 $PROC)
  else
    : # No fallback artwork on this ROM card.
  fi

elif [ -e "/home/ark/.config/.GameLoadingIModeVID" ] && [[ $(tty) != *"pts"* ]]; then
  if [ -f "${launch_root}/launchimages/loading.mp4" ]; then
    ffplay -x 1280 -y 720 -loglevel quiet -autoexit "${launch_root}/launchimages/loading.mp4" &
    PROC=$!
    (sleep 4s; kill -9 $PROC)
  else
    : # No fallback artwork on this ROM card.
  fi
elif [ -e "/home/ark/.config/.GameLoadingIModePIC" ] && [[ $(tty) != *"pts"* ]]; then
  #if [ -e "/home/ark/.config/.IMAGEDELAYTIME" ]; then
  #  delay="$(cat /home/ark/.config/.IMAGEDELAYTIME)"
  #else
    delay="1.5"
  #fi
  if [ -f "${launch_root}/launchimages/loading.jpg" ]; then
    ffplay -x 1280 -y 720 "${launch_root}/launchimages/loading.jpg" &
    PROC=$!
    (sleep ${delay}s; kill -9 $PROC)
  else
    : # No fallback artwork on this ROM card.
  fi
else
  clear > /dev/tty1
fi

echo simple_ondemand > /sys/devices/platform/${gpu}.gpu/devfreq/${gpu}.gpu/governor
echo ondemand > /sys/devices/system/cpu/cpufreq/policy0/scaling_governor
echo dmc_ondemand > /sys/devices/platform/dmc/devfreq/dmc/governor
